{
  "name": "qr-dines-monorepo",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "shared/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/backend run start:dev",
    "dev:backend": "npm --workspace apps/backend run start:dev",
    "dev:frontend": "npm --workspace apps/frontend run dev",
    "build": "npm --workspace apps/backend run build",
    "build:backend": "npm --workspace apps/backend run build",
    "build:frontend": "npm --workspace apps/frontend run build",
    "build:all": "npm run build:backend && npm run build:frontend",
    "test": "npm --workspace apps/backend run test",
    "lint": "npm --workspace apps/backend run lint",
    "lint:frontend": "npm --workspace apps/frontend run lint",
    "audit": "npm audit --omit=dev --audit-level=high",
    "audit:full": "npm audit",
    "check": "npm run lint && npm test && npm run build && npm run audit",
    "docker:build": "docker build -t qr-dines-backend:latest .",
    "db:setup": "scripts/setup-supabase-db.sh",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "backup:db": "scripts/backup-postgres.sh",
    "restore:db": "scripts/restore-postgres.sh"
  },
  "overrides": {
    "postcss": "8.5.26",
    "qs": "6.16.0",
    "multer": "2.4.0",
    "sharp": "^0.35.4",
    "@nestjs/platform-express": {
      "multer": "2.4.0"
    }
  },
  "dependencies": {
    "qs": "6.16.0"
  }
}
