# QR Dines — staging environment template.
# Copy to `.env.staging` and fill in real values. Keep `.env.staging` OFF git.
# Staging deliberately mirrors production config (NODE_ENV=production) so the prod security
# guards apply. Use SEPARATE staging credentials/projects — never point staging at prod.
#
# Backend deploy (docker compose):
#   docker compose --env-file .env.staging -f compose.production.yml up -d --build

# ── Deploy / compose ────────────────────────────────────────────────────────
APP_IMAGE=ghcr.io/OWNER/REPO-backend:staging   # or a pinned tag, e.g. :v1.2.0-rc1
API_DOMAIN=staging-api.qrdines.com
ACME_EMAIL=ops@qrdines.com

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production            # staging mirrors prod so CORS/HSTS/proxy guards apply
PORT=3001
CORS_ORIGINS=https://staging-app.qrdines.com   # comma-separated; no "*" (rejected in prod mode)
TRUST_PROXY_HOPS=1             # expected when running behind Caddy/one proxy

# ── Supabase (required — the app fails to boot without these) ────────────────
# Use a dedicated STAGING Supabase project, not production.
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
SUPABASE_JWT_SECRET=replace-with-staging-jwt-secret

# ── Redis (optional — enables shared rate limiting + realtime fan-out) ───────
# Without these the app runs single-instance (boot-safe). REDIS_MODE defaults to "single".
# Preferred for managed/TLS Redis (e.g. Upstash) — one connection string; ioredis derives TLS +
# auth + host from it. Use rediss:// for TLS. Takes precedence over the discrete vars below.
# REDIS_URL=rediss://default:<token>@<your-endpoint>.upstash.io:6379
# --- or discrete host/port (e.g. local / self-hosted, non-TLS) ---
# REDIS_HOST=your-staging-redis-host
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_MODE=single            # set to "cluster" only for a Redis Cluster
# TENANT_REDIS_KEY=tenants     # optional namespace; defaults to "tenants"

# ── Sentry (optional — error tracking; inert without a DSN) ──────────────────
# Use a SEPARATE staging Sentry project so staging errors stay out of the prod stream
# (errors are tagged with NODE_ENV, which is "production" here — the separate DSN is what
# isolates them).
# SENTRY_DSN=
# SENTRY_RELEASE=              # set to the deployed git SHA
# SENTRY_TRACES_SAMPLE_RATE=0

# ── Optional features ───────────────────────────────────────────────────────
# AUTH_REGISTRATION_TOKEN=     # set a long random secret to allow admin-provisioned registration
# RAZORPAY_WEBHOOK_SECRET=     # leave UNSET — the webhook receiver is dormant WIP and rejects all requests

# ── Scripts (setup / backup / restore) ──────────────────────────────────────
# Direct connection (port 5432, session mode) — required for DDL/pg_restore.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-staging-project.supabase.co:5432/postgres
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14

# ═══════════════════════════════════════════════════════════════════════════
# FRONTEND (separate deploy — NEXT_PUBLIC_* are baked in at BUILD time)
# ═══════════════════════════════════════════════════════════════════════════
# NEXT_PUBLIC_API_URL=https://staging-api.qrdines.com/api   # must include the /api suffix
# NEXT_PUBLIC_SENTRY_DSN=      # browser DSN (staging project)
# SENTRY_DSN=                  # server-side DSN (staging project)
# SENTRY_RELEASE=              # deployed git SHA
