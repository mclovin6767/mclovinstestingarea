# Backend API base URL. This must include the backend global `/api` prefix.
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Production value to set in Vercel:
# NEXT_PUBLIC_API_URL=https://api.qrdines.in/api

# Supabase client-side settings. Use the anon key only; never expose service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
