APP_IMAGE=qr-dines-backend:latest
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

NODE_ENV=production
PORT=3001
CORS_ORIGINS=https://app.example.com
TRUST_PROXY_HOPS=1

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-jwt-secret

# Direct Supabase Postgres connection string used by db setup, backup, and restore scripts.
# Replace [YOUR-PASSWORD] and project ref from Supabase > Project Settings > Database.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
